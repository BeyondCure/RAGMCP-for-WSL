# Copy to .env and adjust as needed.

# Storage
CHROMA_DIR=data/index
COLLECTION=default

# Embedding (bge-m3 = 1024 dims, CPU friendly)
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu
EMBED_BATCH_SIZE=8

# Use the local HuggingFace cache only (no Hub metadata requests).
# Set to false on first run if the model has not been downloaded yet.
HF_HUB_OFFLINE=true

# Chunking (characters). Code blocks may exceed CHUNK_SIZE but never split.
CHUNK_SIZE=900
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=300
MAX_CHUNK_CHARS=6000

# Retrieval
TOP_K=5
RECALL_TOP_N=20

# Optional hybrid retrieval: dense + BM25 fused with reciprocal rank fusion
HYBRID_ENABLED=false
HYBRID_DENSE_N=20
HYBRID_BM25_N=20
HYBRID_RERANK_N=15
HYBRID_RRF_K=60

# Optional cross-encoder reranking (off by default)
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MAX_LENGTH=512

# MCP server (used by runMCPServer.py)
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PRELOAD=true
MCP_MAX_TOP_K=10
# 0 = return full chunks (no truncation)
MCP_MAX_RESULT_CHARS=0
